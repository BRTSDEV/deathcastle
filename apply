QTCT

rgb() { # rrggbb to r,g,b
    printf '%d,%d,%d' "0x$(printf %s "$1" | cut -c1-2)" "0x$(printf %s "$1" | cut -c3-4)" "0x$(printf %s "$1" | cut -c5-6)"
}
kde_group() { # group background alternate
    cat <<KDEGROUP
[Colors:$1]
BackgroundNormal=$(rgb "$2")
BackgroundAlternate=$(rgb "$3")
DecorationFocus=$(rgb "$accent")
DecorationHover=$(rgb "$accent")
ForegroundNormal=$(rgb "$4")
ForegroundInactive=$(rgb "$muted")
ForegroundActive=$(rgb "$accent")
ForegroundLink=$(rgb "$blue")
ForegroundVisited=$(rgb "$magenta")
ForegroundNegative=$(rgb "$red")
ForegroundNeutral=$(rgb "$amber")
ForegroundPositive=$(rgb "$green")

KDEGROUP
}
kde_groups() {
    kde_group Window "$bg" "$surface" "$fg"
    kde_group View "$bg" "$surface" "$fg"
    kde_group Button "$surface" "$bg" "$fg"
    kde_group Header "$surface" "$bg" "$fg"
    kde_group Tooltip "$surface" "$bg" "$fg"
    kde_group Selection "$accent" "$accent" "$bg"
    kde_group Complementary "$bg" "$surface" "$fg"
}
# Dolphin sets its own palette from a named KDE colour scheme, so it needs this file
mkdir -p "$HOME/.local/share/color-schemes"
{
    echo "# Generated by ~/.config/deathcastle/apply. Do not edit."
    echo "[General]"
    echo "Name=DEATHCASTLE"
    echo "ColorScheme=DEATHCASTLE"
    echo
    kde_groups
} > "$HOME/.local/share/color-schemes/DEATHCASTLE.colors"
{
    echo "# Generated by ~/.config/deathcastle/apply. Do not edit."
    echo "[UiSettings]"
    echo "ColorScheme=DEATHCASTLE"
    echo
    echo "[General]"
    echo "ColorScheme=DEATHCASTLE"
    echo "font=$qt_font"
    echo "fixed=$qt_font"
    echo "menuFont=$qt_font"
    echo "toolBarFont=$qt_font"
    echo "smallestReadableFont=$qt_font"
    echo
    echo "[Icons]"
    echo "Theme=breeze-dark"
    echo
    kde_groups
} > "$HOME/.config/kdeglobals"

# Obsidian: themes live per vault, so keep one copy here and install it into every known vault
mix() { # from to percent: the colour percent% of the way from one to the other
    awk -v a="$1" -v b="$2" -v p="$3" 'function h(s) { return index("0123456789abcdef", substr(s, 1, 1)) * 16 + index("0123456789abcdef", substr(s, 2, 1)) - 17 }
    BEGIN { for (i = 1; i <= 5; i += 2) { x = h(substr(a, i, 2)); printf "%02x", x + (h(substr(b, i, 2)) - x) * p / 100 + 0.5 } }'
}
hsl() { # rrggbb to the h, s% and l% Obsidian wants for its accent
    awk -v c="$1" 'function h(s) { return index("0123456789abcdef", substr(s, 1, 1)) * 16 + index("0123456789abcdef", substr(s, 2, 1)) - 17 }
    BEGIN { r = h(substr(c, 1, 2)) / 255; g = h(substr(c, 3, 2)) / 255; b = h(substr(c, 5, 2)) / 255
        M = r; if (g > M) M = g; if (b > M) M = b; m = r; if (g < m) m = g; if (b < m) m = b
        d = M - m; l = (M + m) / 2; s = d == 0 ? 0 : d / (1 - (2 * l - 1 < 0 ? 1 - 2 * l : 2 * l - 1))
        if (d == 0) H = 0; else if (M == r) H = (g - b) / d + (g < b ? 6 : 0); else if (M == g) H = (b - r) / d + 2; else H = (r - g) / d + 4
        printf "--accent-h: %d; --accent-s: %.0f%%; --accent-l: %.0f%%;", H * 60 + 0.5, s * 100, l * 100 }'
}
ob_theme="$HOME/.config/deathcastle/obsidian/DEATHCASTLE"
mkdir -p "$ob_theme"
cat > "$ob_theme/manifest.json" <<OBMANIFEST
{
  "name": "DEATHCASTLE",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "author": "$(id -un)"
}
OBMANIFEST
cat > "$ob_theme/theme.css" <<OBTHEME
/* Generated by ~/.config/deathcastle/apply. Do not edit. */
.theme-dark {
  /* Palette */
  --color-base-00: #$bg;
  --color-base-05: #$(mix "$bg" "$surface" 20);
  --color-base-10: #$(mix "$bg" "$surface" 35);
  --color-base-20: #$(mix "$bg" "$surface" 50);
  --color-base-25: #$(mix "$bg" "$surface" 75);
  --color-base-30: #$surface;
  --color-base-35: #$(mix "$surface" "$muted" 15);
  --color-base-40: #$(mix "$surface" "$muted" 30);
  --color-base-50: #$(mix "$surface" "$muted" 70);
  --color-base-60: #$muted;
  --color-base-70: #$(mix "$muted" "$fg" 50);
  --color-base-100: #$fg;
  $(hsl "$accent")
  --color-accent: #$accent;
  --color-accent-1: #$accent;
  --color-accent-2: #$fg;
  --color-red: #$red;      --color-red-rgb: $(rgb "$red");
  --color-orange: #$amber; --color-orange-rgb: $(rgb "$amber");
  --color-yellow: #$amber; --color-yellow-rgb: $(rgb "$amber");
  --color-green: #$green;  --color-green-rgb: $(rgb "$green");
  --color-cyan: #$cyan;    --color-cyan-rgb: $(rgb "$cyan");
  --color-blue: #$blue;    --color-blue-rgb: $(rgb "$blue");
  --color-purple: #$magenta; --color-purple-rgb: $(rgb "$magenta");
  --color-pink: #$magenta;   --color-pink-rgb: $(rgb "$magenta");

  /* The accent is pale, so text on it has to be dark */
  --text-on-accent: #$bg;
  --text-on-accent-inverted: #$bg;
  --text-selection: #$surface;
  --text-highlight-bg: rgba($(rgb "$amber"), 0.3);
  --text-highlight-bg-active: rgba($(rgb "$amber"), 0.55);

  /* Flat surfaces: same night colour everywhere, split by thin lines */
  --background-primary: #$bg;
  --background-primary-alt: #$(mix "$bg" "$surface" 50);
  --background-secondary: #$bg;
  --background-secondary-alt: #$surface;
  --titlebar-background: #$bg;
  --titlebar-background-focused: #$bg;
  --ribbon-background: #$bg;
  --ribbon-background-collapsed: #$bg;
  --tab-container-background: #$bg;
  --tab-background-active: #$bg;
  --divider-color: #$surface;
  --tab-outline-color: #$surface;
  --input-shadow: none;
  --input-shadow-hover: none;
  --shadow-edges: 0 0 0 1px #$surface;

  /* One font */
  --font-interface-theme: "$font", monospace;
  --font-text-theme: "$font", monospace;
  --font-monospace-theme: "$font", monospace;

  /* Graph */
  --graph-node: #$muted;
  --graph-node-focused: #$accent;
  --graph-node-tag: #$cyan;
  --graph-node-attachment: #$amber;
  --graph-line: #$surface;
}

/* Hard corners, everywhere */
.theme-dark *, .theme-dark *::before, .theme-dark *::after,
.theme-dark ::-webkit-scrollbar-thumb, .theme-dark ::-webkit-scrollbar-track {
  border-radius: 0 !important;
}

/* Current tab looks like the current kitty tab */
.theme-dark .workspace-tabs.mod-active .workspace-tab-header.is-active {
  background-color: #$accent;
  --tab-text-color-focused-active-current: #$bg;
  --icon-color: #$bg;
  --icon-color-hover: #$bg;
  --background-modifier-hover: transparent;
}
.theme-dark .workspace-tabs.mod-active .workspace-tab-header.is-active .workspace-tab-header-inner-close-button {
  color: #$bg;
  opacity: 1;
}
.theme-dark .workspace-tab-header::before, .theme-dark .workspace-tab-header::after,
.theme-dark .workspace-tab-header-inner::after { display: none; }

/* Selected thing in lists, thin moon bar instead of a soft blob */
.theme-dark .nav-file-title.is-active, .theme-dark .tree-item-self.is-active {
  background-color: #$surface;
  box-shadow: inset 2px 0 0 #$accent;
}
OBTHEME
# New vaults only get the theme after the next run of this script
if [ -f "$HOME/.config/obsidian/obsidian.json" ]; then
python3 -I - "$ob_theme" <<'OBINSTALL'
import json, os, shutil, sys
theme = sys.argv[1]
try:
    with open(os.path.expanduser("~/.config/obsidian/obsidian.json")) as f:
        vaults = json.load(f).get("vaults", {}).values()
except (FileNotFoundError, ValueError):
    vaults = []
for vault in vaults:
    conf = os.path.join(vault["path"], ".obsidian")
    if not os.path.isdir(conf):
        continue
    shutil.copytree(theme, os.path.join(conf, "themes", "DEATHCASTLE"), dirs_exist_ok=True)
    path = os.path.join(conf, "appearance.json")
    try:
        with open(path) as f:
            appearance = json.load(f)
    except (FileNotFoundError, ValueError):
        appearance = {}
    appearance.update(cssTheme="DEATHCASTLE", theme="obsidian")
    with open(path, "w") as f:
        json.dump(appearance, f, indent=2)
OBINSTALL
fi

