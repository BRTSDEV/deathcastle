QToolButton { border: 1px solid transparent; border-radius: 0; padding: 3px; }
QToolButton:hover { border-color: #$accent; }
QToolButton:checked, QToolButton:pressed { background-color: #$surface; border-color: #$accent; }
QTabBar::tab { background-color: #$bg; color: #$muted; border: 1px solid #$surface; border-radius: 0; padding: 4px 12px; }
QTabBar::tab:selected { background-color: #$surface; color: #$fg; }
QTQSS
cat > "$HOME/.config/qt6ct/qt6ct.conf" <<QTCT
[Appearance]
