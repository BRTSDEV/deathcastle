#!/bin/sh
# Generate app colours from the DEATHCASTLE palette and reload what is running.
set -e
. "$HOME/.config/deathcastle/palette"
mkdir -p "$HOME/.config/kitty" "$HOME/.config/hypr" "$HOME/.config/waybar"

# kitty
cat > "$HOME/.config/kitty/deathcastle.conf" <<KITTY
# Generated by ~/.config/deathcastle/apply. Do not edit.
font_family          $font
background           #$bg
foreground           #$fg
cursor               #$accent
cursor_text_color    #$bg
selection_background #$surface
selection_foreground #$fg
url_color            #$blue
active_tab_background   #$accent
active_tab_foreground   #$bg
inactive_tab_background #$surface
inactive_tab_foreground #$muted
tab_bar_background      #$bg
color0  #$surface
color8  #$muted
color1  #$red
color9  #$red
color2  #$green
color10 #$green
color3  #$amber
color11 #$amber
color4  #$blue
color12 #$blue
color5  #$magenta
color13 #$magenta
color6  #$cyan
color14 #$cyan
color7  #$fg
color15 #$fg
KITTY

# Hyprland
cat > "$HOME/.config/hypr/deathcastle.lua" <<HYPR
-- Generated by ~/.config/deathcastle/apply. Do not edit.
return {
    bg      = "rgb($bg)",
    surface = "rgb($surface)",
    muted   = "rgb($muted)",
    fg      = "rgb($fg)",
    accent  = "rgb($accent)",
    amber   = "rgb($amber)",
    cursor  = "$cursor",
    cursor_size = "$cursor_size",
}
HYPR

# Waybar
cat > "$HOME/.config/waybar/colors.css" <<WAYBAR
/* Generated by ~/.config/deathcastle/apply. Do not edit. */
@define-color bg #$bg;
@define-color surface #$surface;
@define-color muted #$muted;
@define-color fg #$fg;
@define-color accent #$accent;
@define-color amber #$amber;
* { font-family: "$font", monospace; }
WAYBAR

# Hyprtoolkit apps: launcher and Hyprland dialogs
cat > "$HOME/.config/hypr/hyprtoolkit.conf" <<TOOLKIT
# Generated by ~/.config/deathcastle/apply. Do not edit.
background = 0xe6$bg
base = 0xff$surface
alternate_base = 0xff$bg
text = 0xff$fg
bright_text = 0xff$fg
accent = 0xff$accent
accent_secondary = 0xff$amber
font_family = $font
rounding_large = 0
rounding_small = 0
TOOLKIT

# GTK apps
for dir in gtk-3.0 gtk-4.0; do
    mkdir -p "$HOME/.config/$dir"
    cat > "$HOME/.config/$dir/settings.ini" <<GTKINI
# Generated by ~/.config/deathcastle/apply. Do not edit.
[Settings]
gtk-application-prefer-dark-theme=1
gtk-font-name=$font 10
gtk-cursor-theme-name=$cursor
gtk-cursor-theme-size=$cursor_size
GTKINI
    cat > "$HOME/.config/$dir/gtk.css" <<GTKCSS
/* Generated by ~/.config/deathcastle/apply. Do not edit. */
@define-color theme_bg_color #$bg;
@define-color theme_fg_color #$fg;
@define-color theme_base_color #$bg;
@define-color theme_text_color #$fg;
@define-color theme_selected_bg_color #$accent;
@define-color theme_selected_fg_color #$bg;
@define-color borders #$surface;
@define-color window_bg_color #$bg;
@define-color window_fg_color #$fg;
@define-color view_bg_color #$bg;
@define-color view_fg_color #$fg;
@define-color headerbar_bg_color #$surface;
@define-color headerbar_fg_color #$fg;
@define-color accent_bg_color #$accent;
@define-color accent_fg_color #$bg;
@define-color accent_color #$accent;
GTKCSS
done

# Hyprlock
cat > "$HOME/.config/hypr/hyprlock-colors.conf" <<LOCK
# Generated by ~/.config/deathcastle/apply. Do not edit.
\$bg = rgb($bg)
\$surface = rgb($surface)
\$fg = rgb($fg)
\$accent = rgb($accent)
\$amber = rgb($amber)
\$font = $font
LOCK

# Mako
mkdir -p "$HOME/.config/mako"
cat > "$HOME/.config/mako/config" <<MAKO
# Generated by ~/.config/deathcastle/apply. Do not edit.
font=$font Bold 11
background-color=#${bg}e6
text-color=#$fg
border-color=#$accent
progress-color=over #$surface
border-size=2
border-radius=0
padding=8
margin=12
width=360
anchor=top-right
default-timeout=5000

[urgency=high]
border-color=#$amber
default-timeout=0
MAKO
# Popup styling for the optional remind tool, only if it is installed
if [ -x "$HOME/.local/bin/remind" ]; then
    cat >> "$HOME/.config/mako/config" <<MAKO

[app-name=remind]
layer=overlay

[app-name=remind urgency=high]
font=$font Bold 13
width=440
height=160
padding=14,18
border-size=3
background-color=#${bg}f5
format=<span font_family='Symbols Nerd Font Mono' weight='normal' color='#$amber'>󰂚</span>  <b>%s</b>\\n<span color='#$accent'>%b</span>\\n<span size='small' color='#$muted'>click: done    right-click: 10 more min</span>
on-button-left=dismiss
on-button-right=exec \$HOME/.local/bin/remind snooze \$id
MAKO
fi

# Rofi
mkdir -p "$HOME/.config/rofi"
cat > "$HOME/.config/rofi/deathcastle.rasi" <<ROFI
/* Generated by ~/.config/deathcastle/apply. Do not edit. */
* {
    background-color: transparent;
    text-color: #$fg;
    font: "$font Bold 12";
}
window {
    width: 480px;
    background-color: #${bg}d9;
    border: 2px;
    border-color: #$accent;
    border-radius: 0;
}
mainbox { padding: 8px; spacing: 8px; }
inputbar { children: [prompt, entry]; spacing: 8px; padding: 6px 8px; background-color: #$surface; }
prompt { text-color: #$accent; }
entry { placeholder: "search"; placeholder-color: #$muted; }
listview { lines: 8; scrollbar: false; spacing: 2px; }
element { padding: 4px 8px; }
element selected { background-color: #$accent; text-color: #$bg; }
element-text { text-color: inherit; }
message { padding: 2px 8px; }
textbox { text-color: #$muted; }
