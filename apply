# Hard corners and plain surfaces are settings, not theme colours. Install only when the theme changed.
if command -v code >/dev/null 2>&1; then
    python3 -I - "$vs_ext" "$font" <<'VSINSTALL' || echo "apply: VS Code theme not installed" >&2
import filecmp, glob, json, os, subprocess, sys, tempfile, zipfile
ext, font = sys.argv[1:]
manifest = json.load(open(os.path.join(ext, "package.json")))
theme = "themes/deathcastle-color-theme.json"
id_ = f'{manifest["publisher"]}.{manifest["name"]}'
installed = glob.glob(os.path.expanduser(f'~/.vscode/extensions/{id_}-*/{theme}'))
if not (installed and filecmp.cmp(installed[0], os.path.join(ext, theme), shallow=False)):
    vsixmanifest = f'''<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Language="en-US" Id="{manifest["name"]}" Version="{manifest["version"]}" Publisher="{manifest["publisher"]}"/>
    <DisplayName>{manifest["displayName"]}</DisplayName>
    <Description xml:space="preserve">{manifest["description"]}</Description>
    <Categories>Themes</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value="{manifest["engines"]["vscode"]}"/>
    </Properties>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation>
  <Dependencies/>
  <Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/></Assets>
</PackageManifest>
'''
    types = '''<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension=".json" ContentType="application/json"/>
  <Default Extension=".vsixmanifest" ContentType="text/xml"/>
</Types>
'''
    with tempfile.TemporaryDirectory() as tmp:
        vsix = os.path.join(tmp, "deathcastle.vsix")
        with zipfile.ZipFile(vsix, "w", zipfile.ZIP_DEFLATED) as z:
            z.writestr("extension.vsixmanifest", vsixmanifest)
            z.writestr("[Content_Types].xml", types)
            z.write(os.path.join(ext, "package.json"), "extension/package.json")
            z.write(os.path.join(ext, theme), "extension/" + theme)
        subprocess.run(["code", "--install-extension", vsix, "--force"],
                       check=True, stdout=subprocess.DEVNULL)
path = os.path.expanduser("~/.config/Code/User/settings.json")
try:
    with open(path) as f:
        settings = json.load(f)
except FileNotFoundError:
    settings = {}
except ValueError:
    # VS Code allows comments here. Do not rewrite a file this parser would mangle.
    print(f"apply: {path} has comments, set workbench.colorTheme to DEATHCASTLE by hand", file=sys.stderr)
    sys.exit(0)
settings.update({
    "workbench.colorTheme": "DEATHCASTLE",
    "editor.fontFamily": f"'{font}', monospace",
    "terminal.integrated.fontFamily": f"'{font}', monospace",
    "editor.roundedSelection": False,
    "workbench.experimental.modernUI": False,
    "workbench.shadows": False,
})
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w") as f:
    json.dump(settings, f, indent=4)
    f.write("\n")
VSINSTALL
fi

