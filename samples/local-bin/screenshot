#!/bin/sh
# Save a screenshot to ~/Pictures/Screenshots and copy it to the clipboard.
# Usage: screenshot [region|full]   (default: region)
dir="$HOME/Pictures/Screenshots"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$dir"

case "${1:-region}" in
    region)
        area=$(slurp) || exit 0   # Esc cancels
        grim -g "$area" "$file"
        ;;
    full)
        grim "$file"
        ;;
    *)
        echo "usage: screenshot [region|full]" >&2
        exit 2
        ;;
esac || exit 1

wl-copy --type image/png < "$file"
