def kelvin(k):
    """Same blackbody fit as the shader, as 0..1 floats, for drawing the UI."""
    t = k / 100
    r = 255 if t <= 66 else 329.698727446 * (t - 60) ** -0.1332047592
    g = 99.4708025861 * math.log(t) - 161.1195681661 if t <= 66 else 288.1221695283 * (t - 60) ** -0.0755148492
    b = 255 if t >= 66 else (0 if t <= 19 else 138.5177312231 * math.log(t - 10) - 305.0447927307)
    return tuple(min(max(c / 255, 0), 1) for c in (r, g, b))


def css_rgb(rgb):
    return "rgb({},{},{})".format(*(round(c * 255) for c in rgb))


def palette():
    """The @define-color lines of the generated Waybar colours, as 0..1 RGB tuples."""
    out = {"bg": "#11161c", "surface": "#232a31", "muted": "#7e929d", "fg": "#d5dee6",
           "accent": "#a9c1cf", "amber": "#e0b060"}
    try:
        for line in open(COLORS):
            parts = line.split()
            if len(parts) == 3 and parts[0] == "@define-color":
                out[parts[1]] = parts[2].rstrip(";")
    except OSError:
        pass
    return {k: tuple(int(v[i:i + 2], 16) / 255 for i in (1, 3, 5)) for k, v in out.items()}


PAL = palette()


def battlements(_area, cr, w, h):
    """A wall top across the popup: merlons standing on a solid course."""
    cr.set_antialias(cairo.Antialias.NONE)
    cr.set_source_rgb(*PAL["accent"])
    cr.rectangle(0, h - 4, w, 4)
    merlon, gap = 14, 10
    count = (w + gap) // (merlon + gap)
    x = (w - (count * merlon + (count - 1) * gap)) // 2  # centred, same at both ends
    for _ in range(count):
        cr.rectangle(x, 0, merlon, h)
        x += merlon + gap
    cr.fill()


def merlons(cr, x, top, width, size=5, gap=3):
    n = max((width + gap) // (size + gap), 1)
    x0 = x + (width - (n * size + (n - 1) * gap)) // 2
    for i in range(n):
        cr.rectangle(x0 + i * (size + gap), top - size, size, size)


def sky_clock(now=None):
    """Where we are in the day: (is_day, 0..1 across the sky from rise to set)."""
    now = now or datetime.datetime.now()
    hour = now.hour + now.minute / 60
    day_len = SUNSET - SUNRISE
    if SUNRISE <= hour < SUNSET:
        return True, (hour - SUNRISE) / day_len
    return False, ((hour - SUNSET) % 24) / (24 - day_len)


def skyline(cr, w, h, lit, now=None):
    """The sky with the sun or moon on its arc, a castle in front, windows lit by the tint (None = dark)."""
    is_day, p = sky_clock(now)
    sky = PAL["bg"]
    if is_day:  # a lighter slate by day, never bright enough to fight the night mode
        sky = tuple(b + (a - b) * 0.22 for a, b in zip(PAL["accent"], PAL["bg"]))
    cr.set_antialias(cairo.Antialias.NONE)
    cr.set_source_rgb(*sky)
    cr.paint()

    if not is_day:
        stars = random.Random(7)  # same sky every time
        cr.set_source_rgb(*PAL["muted"])
        for _ in range(w // 9):
            cr.rectangle(stars.randrange(w), stars.randrange(h - 20), 1, 1)
        cr.fill()

    # rises on the left, highest at midday/midnight, sets on the right behind the wall
    horizon, top = h - 12, 10
    x = int(10 + p * (w - 20))
    y = int(horizon - math.sin(math.pi * p) * (horizon - top))
    if is_day:
        cr.set_source_rgb(*PAL["amber"])
        for i in range(8):  # pixel rays
            a = i * math.pi / 4
            cr.rectangle(int(x + math.cos(a) * 9) - 1, int(y + math.sin(a) * 9) - 1, 2, 2)
        cr.fill()
        cr.set_antialias(cairo.Antialias.DEFAULT)
        cr.arc(x, y, 5, 0, 2 * math.pi)
        cr.fill()
    else:  # crescent: a pale disc with a sky-coloured bite
        cr.set_antialias(cairo.Antialias.DEFAULT)
        cr.set_source_rgb(*PAL["accent"])
        cr.arc(x, y, 7, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgb(*sky)
        cr.arc(x + 4, y - 2, 6, 0, 2 * math.pi)
        cr.fill()
    cr.set_antialias(cairo.Antialias.NONE)

    tl, keep, turret, tr = 14, w // 2 - 24, int(w * 0.30), w - 40
    o = h - 48  # the castle stands on the ground; everything above it is sky
    blocks = [  # x, top, width
        (0, h - 14, w),       # curtain wall
        (tl, o + 14, 24),     # left tower
        (turret, o + 24, 14), # turret
        (keep, o + 6, 48),    # keep
        (tr, o + 18, 24),     # right tower
    ]
    cr.set_source_rgb(*PAL["surface"])
    for x, top, width in blocks:
        cr.rectangle(x, top, width, h - top)
        merlons(cr, x, top, width, size=4 if width < 20 else 5)
    cr.fill()

    windows = [(tl + 9, o + 22, 6, 8), (turret + 5, o + 30, 4, 6), (keep + 9, o + 14, 6, 8), (keep + 33, o + 14, 6, 8),
               (keep + 21, o + 26, 6, 9), (tr + 9, o + 26, 6, 8), (int(w * 0.18), h - 9, 3, 5), (int(w * 0.83), h - 9, 3, 5)]
    if lit:
        cr.set_source_rgba(*lit, 0.22)  # faint glow on the stone
        for x, y, ww, hh in windows:
            cr.rectangle(x - 2, y - 2, ww + 4, hh + 4)
        cr.fill()
    cr.set_source_rgb(*(lit or PAL["bg"]))
    for x, y, ww, hh in windows:
        cr.rectangle(x, y, ww, hh)
    cr.fill()

    cr.set_source_rgb(*PAL["bg"])  # gate
    cr.rectangle(keep + 19, h - 12, 10, 12)
    cr.fill()


def read_num(name, default):
    try:
        return int(open(f"{STATE}/{name}").read().strip())
    except (OSError, ValueError):
        return default


class Live(threading.Thread):
    """Pushes the newest (temp, bright) to Hyprland; older ones are dropped, never queued."""

    def __init__(self):
        super().__init__(daemon=True)
        self.template = open(TEMPLATE).read()
        self.cond = threading.Condition()
        self.want = None
        self.flip = False

    def push(self, temp, bright):
        with self.cond:
            self.want = (temp, bright)
            self.cond.notify()

    def run(self):
        while True:
            with self.cond:
                while self.want is None:
                    self.cond.wait()
                temp, bright = self.want
                self.want = None
            # Hyprland may skip a path it already has, so flip between two files.
            self.flip = not self.flip
            path = f"{STATE}/menu-{'a' if self.flip else 'b'}.frag"  # not the files nightmode uses
            with open(path, "w") as f:
                f.write(self.template.replace("@TEMP@", str(temp)).replace("@BRIGHT@", str(bright)))
            try:
                with socket.socket(socket.AF_UNIX) as s:
                    s.connect(SOCKET)
                    s.sendall(f'eval hl.config({{ decoration = {{ screen_shader = "{path}" }} }})'.encode())
                    s.recv(64)
            except OSError:
                pass


class Latest(threading.Thread):
    """Runs fn with the newest value given to push(); values that pile up are skipped."""

    def __init__(self, fn):
        super().__init__(daemon=True)
        self.fn = fn
        self.cond = threading.Condition()
        self.want = None

    def push(self, value):
        with self.cond:
            self.want = value
            self.cond.notify()

    def run(self):
        while True:
            with self.cond:
                while self.want is None:
                    self.cond.wait()
                value, self.want = self.want, None
            self.fn(value)


