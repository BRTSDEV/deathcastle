def sh(*args):
    """Run a command, return its stdout ('' on any failure)."""
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def volume():
    """(percent, muted) of the default output."""
    out = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@").split()  # "Volume: 0.40 [MUTED]"
    try:
        return round(float(out[1]) * 100), "[MUTED]" in out
    except (IndexError, ValueError):
        return 0, False


def outputs():
    """[(name, short label, is_default, kind)] for every audio output."""
    try:
        sinks = json.loads(sh("pactl", "-f", "json", "list", "sinks") or "[]")
    except ValueError:
        sinks = []
    default = sh("pactl", "get-default-sink").strip()
    def kind(x):
        props = x.get("properties", {})
        if props.get("device.form_factor") in ("headset", "headphone") or "headset" in x["name"].lower():
            return "headset"
        return "monitor" if "hdmi" in x["name"].lower() or "displayport" in x["name"].lower() else "speaker"
    return [(x["name"], (x["properties"].get("node.nick") or x["description"])[:13], x["name"] == default, kind(x))
            for x in sinks]


def network():
    """(kind, text) for the interface with the default route; kind is wired, wifi or down. Never the IP."""
    dev = ""
    for line in sh("ip", "-4", "route", "show", "default").splitlines():
        parts = line.split()
        if "dev" in parts:
            dev = parts[parts.index("dev") + 1]
            break
    if not dev:
        return "down", "OFFLINE"
    if os.path.exists(f"/sys/class/net/{dev}/wireless"):
        ssid = sh("iw", "dev", dev, "link")
        ssid = next((l.split(":", 1)[1].strip() for l in ssid.splitlines() if "SSID" in l), "")
        return "wifi", ssid[:16].upper() if ssid else "WIFI"
    try:
        speed = int(open(f"/sys/class/net/{dev}/speed").read())
        return "wired", f"WIRED · {speed // 1000} Gb/s" if speed >= 1000 else f"WIRED · {speed} Mb/s"
    except (OSError, ValueError):
        return "wired", "WIRED"


def shutdown_then(label, cmd, fallback=None):
    """Close every app cleanly, leave Hyprland, then run cmd.
    Without hyprshutdown it runs fallback, or cmd itself."""
    return (f"if command -v hyprshutdown >/dev/null; then hyprshutdown -t '{label}' -p '{cmd}'; "
            f"else {fallback or cmd}; fi")


