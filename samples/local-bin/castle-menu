def label(text="", *classes, xalign=0.0, hexpand=False):
    w = Gtk.Label(label=text, xalign=xalign, hexpand=hexpand)
    for c in classes:
        w.add_css_class(c)
    return w


def glyph(name, *classes):
    return label(GLYPH[name], "glyph", *classes, xalign=0.5)


def hbox(*children, spacing=0, cls=None):
    b = Gtk.Box(spacing=spacing)
    for c in children:
        b.append(c)
    if cls:
        b.add_css_class(cls)
    return b


def vbox(*children, spacing=0, cls=None):
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    for c in children:
        b.append(c)
    if cls:
        b.add_css_class(cls)
    return b


def section_head(icon, name, right):
    """One header style for every section: glyph, tracked name, control on the right."""
    return hbox(glyph(icon, "section-glyph"), label(name, "section", hexpand=True), right, spacing=6)


class Menu(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Castle")
        self.set_default_size(300, -1)
        self.set_resizable(False)
        self.live = Live()
        self.live.start()
        self.save_timer = None
        self.anim = None
        self.quiet = False      # set while code (not you) moves the controls
        self.vol_quiet = False
        self.vol_touched = 0    # when you last moved the volume; live polling waits for you
        self.armed = None

        self.is_on = os.path.exists(f"{STATE}/on")
        self.temp_v = read_num("temp", 3400)
        self.bright_v = read_num("bright", 85)

        wall = Gtk.DrawingArea(content_height=12)
        wall.set_draw_func(battlements)

        self.lit = None
        self.preview = Gtk.DrawingArea(content_height=64)
        self.preview.set_draw_func(lambda _a, cr, w, h: skyline(cr, w, h, self.lit))
        self.preview.add_css_class("sky")

        self.clock = label("", "clock")
        head = hbox(label(GLYPH["tower"], "glyph", "tower"), label("DEATHCASTLE", "title", hexpand=True),
                    self.clock, spacing=8, cls="head")

        keep = vbox(head, self.preview,
                    self.night_section(), self.stone(),
                    self.sound_section(), self.stone(),
                    self.network_section(), self.stone(),
                    self.power_section(), cls="keep")
        self.set_child(vbox(wall, keep))

        self.refresh()
        self.tick()
        GLib.timeout_add_seconds(1, self.poll_sound)
        GLib.timeout_add_seconds(5, self.poll_network)
        GLib.timeout_add_seconds(20, self.tick)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_focus)
        self.connect("close-request", self.on_close)

    def stone(self):
        return hbox(cls="stone")

    def tick(self):
        """Clock in the header and the sun/moon in the sky."""
        self.clock.set_label(datetime.datetime.now().strftime("%a %H:%M").upper())
        self.preview.queue_draw()
        return True

    def slider(self, name, lo, hi, step, value, on_change, *classes):
        val = label("", "value", xalign=1)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        scale.set_draw_value(False)
        scale.set_round_digits(0)
        scale.set_increments(step, step * 5)
        scale.set_value(value)
        for c in classes:
            scale.add_css_class(c)
        scale.connect("value-changed", on_change)
        return vbox(hbox(label(name, "sub", hexpand=True), val), scale), val, scale

    # ---- night mode ----------------------------------------------------

    def night_section(self):
        self.switch = Gtk.Switch(active=self.is_on, valign=Gtk.Align.CENTER)
        self.switch.set_tooltip_text("night mode on/off")
        self.switch.connect("notify::active", self.on_switch)

        warm, self.temp_val, self.temp = self.slider("WARMTH", T_MIN, T_MAX, 50, self.temp_v, self.on_slide, "warm")
        self.temp.set_inverted(True)  # right = warmer
        bright, self.bright_val, self.bright = self.slider("BRIGHTNESS", B_MIN, 100, 1, self.bright_v,
                                                          self.on_slide, "bright")
        presets = Gtk.Box(spacing=4, homogeneous=True)
        self.preset_btns = []
        for name, t, b in PRESETS:
            btn = Gtk.Button(label=name)
            btn.set_tooltip_text(f"{t}K · {b}%")
            btn.connect("clicked", lambda _b, t=t, b=b: self.go_to(t, b))
            presets.append(btn)
            self.preset_btns.append((btn, t, b))

        self.night = vbox(section_head("night", "NIGHT MODE", self.switch),
                          vbox(warm, bright, presets, spacing=8, cls="controls"),
                          spacing=10, cls="part")
        return self.night

    # ---- sound ---------------------------------------------------------

    def sound_section(self):
        self.vol_push = Latest(lambda v: sh("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v / 100:.2f}"))
        self.vol_push.start()

        self.sound_switch = Gtk.Switch(valign=Gtk.Align.CENTER)  # on = sound, off = muted
        self.sound_switch.set_tooltip_text("mute")
        self.sound_switch.connect("notify::active", self.on_mute)
        self.sound_glyph = glyph("sound", "section-glyph")

        vol, self.vol_val, self.vol = self.slider("VOLUME", 0, 100, 1, 0, self.on_volume, "vol")
        self.out_row = Gtk.Box(spacing=4, homogeneous=True)

        head = hbox(self.sound_glyph, label("SOUND", "section", hexpand=True), self.sound_switch, spacing=6)
        self.sound = vbox(head, vbox(vol, self.out_row, spacing=8, cls="controls"), spacing=10, cls="part")
        self.out_key = None
        self.read_sound()
        return self.sound

    def read_sound(self):
        """Pull volume, mute and outputs from PipeWire into the controls."""
        v, muted = volume()
        self.vol_quiet = True
        if int(self.vol.get_value()) != v:
            self.vol.set_value(v)
        if self.sound_switch.get_active() == muted:
            self.sound_switch.set_active(not muted)
        self.vol_quiet = False
        self.muted = muted
        self.show_sound()

        outs = outputs()
        key = tuple((n, d) for n, _s, d, _k in outs)
        if key == self.out_key:  # nothing changed, keep the buttons (and their hover) as they are
            return
        self.out_key = key
        while (c := self.out_row.get_first_child()):
            self.out_row.remove(c)
        for name, short, is_default, kind in outs:
            btn = Gtk.Button()
            btn.set_child(hbox(glyph(kind), label(short.upper()), spacing=6))
            btn.get_child().set_halign(Gtk.Align.CENTER)
            btn.set_tooltip_text(f"play sound on {short}")
            if is_default:
                btn.add_css_class("active")
            btn.connect("clicked", self.on_output, name)
            self.out_row.append(btn)
        self.out_row.set_visible(len(outs) > 1)

    def show_sound(self):
        self.vol_val.set_label("MUTED" if self.muted else f"{int(self.vol.get_value())}%")
        self.sound_glyph.set_label(GLYPH["muted" if self.muted else "sound"])
        (self.sound.add_css_class if self.muted else self.sound.remove_css_class)("resting")

    def on_volume(self, _scale):
        if self.vol_quiet:
            return
        self.vol_touched = GLib.get_monotonic_time()
        self.vol_push.push(int(self.vol.get_value()))
        self.show_sound()

    def on_mute(self, sw, _p):
        if self.vol_quiet:
            return
        sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0" if sw.get_active() else "1")
        self.muted = not sw.get_active()
        self.show_sound()

    def on_output(self, _btn, name):
        sh("pactl", "set-default-sink", name)
        self.read_sound()  # each output has its own volume

    def poll_sound(self):
        """Follow volume keys and other apps while the menu is open, but never fight a drag."""
        if GLib.get_monotonic_time() - self.vol_touched > 1_500_000:
            self.read_sound()
        return True

    # ---- network -------------------------------------------------------

    def network_section(self):
        self.net_glyph = glyph("wired", "section-glyph")
        self.net_state = label("", xalign=1)
        self.poll_network()
        return hbox(self.net_glyph, label("NETWORK", "section", hexpand=True), self.net_state,
                    spacing=6, cls="part")

    def poll_network(self):
        kind, text = network()
        self.net_glyph.set_label(GLYPH[kind])
        self.net_state.set_label(text)
        for c in ("net-up", "net-down"):
            self.net_state.remove_css_class(c)
        self.net_state.add_css_class("net-down" if kind == "down" else "net-up")
        return True

    # ---- power ---------------------------------------------------------

    def power_section(self):
        self.power_hint = label("", "hint", xalign=1)
        row = Gtk.Box(spacing=4, homogeneous=True)
        row.add_css_class("power")
        for icon, name, verb, cmd, confirm in POWER:
            btn = Gtk.Button()
            btn.set_child(vbox(label(icon, "glyph", xalign=0.5), label(name, "name", xalign=0.5), spacing=3))
            btn.set_tooltip_text(verb + (" (click twice)" if confirm else ""))
            if confirm:
                btn.add_css_class("danger")
            btn.connect("clicked", self.on_power, verb, cmd, confirm)
            row.append(btn)
        return vbox(section_head("power", "POWER", self.power_hint), row, spacing=10, cls="part")

    def on_power(self, btn, verb, cmd, confirm):
        if confirm and (self.armed is None or self.armed[0] is not btn):
            self.disarm()
            btn.add_css_class("armed")
            self.power_hint.set_label(f"AGAIN TO {verb.upper()}")
            self.armed = (btn, GLib.timeout_add_seconds(CONFIRM_SECS, self.disarm))
            return
        self.disarm()
        self.close()  # get out of the way first (lock screen, shutdown screen)
        subprocess.Popen(["sh", "-c", cmd], start_new_session=True)

    def disarm(self):
        if self.armed:
            btn, timer = self.armed
            self.armed = None
            GLib.source_remove(timer)
            btn.remove_css_class("armed")
            self.power_hint.set_label("")
        return False

    # ---- night mode logic ----------------------------------------------

    def refresh(self):
        t, b = int(self.temp.get_value()), int(self.bright.get_value())
        self.temp_val.set_label(f"{t}K")
        self.bright_val.set_label(f"{b}%")
        if self.is_on:
            self.lit = tuple(c * b / 100 for c in kelvin(t))
            self.night.remove_css_class("resting")
        else:
            self.lit = None  # all windows dark
            self.night.add_css_class("resting")
        self.preview.queue_draw()
        for btn, pt, pb in self.preset_btns:
            (btn.add_css_class if self.is_on and (pt, pb) == (t, b) else btn.remove_css_class)("active")

    def on_slide(self, _scale):
        if not self.quiet:
            self.stop_anim()
            if not self.is_on:
                self.set_switch(True)
            self.temp_v, self.bright_v = int(self.temp.get_value()), int(self.bright.get_value())
            self.live.push(self.temp_v, self.bright_v)
            self.schedule_save()
        self.refresh()

    def on_switch(self, sw, _p):
        if self.quiet:
            return
        self.is_on = sw.get_active()
        if self.is_on:  # fade in from neutral
            self.fade(NEUTRAL, (self.temp_v, self.bright_v), move_sliders=False, done=self.save_now)
        else:           # fade out, then let nightmode drop the shader
            self.fade((self.temp_v, self.bright_v), NEUTRAL, move_sliders=False,
                      done=lambda: subprocess.Popen([TOOL, "off"]))
        self.refresh()

    def set_switch(self, on):
        self.quiet = True
        self.switch.set_active(on)
        self.quiet = False
        self.is_on = on

    def go_to(self, t, b):
        if not self.is_on:
            self.set_switch(True)
        self.fade((self.temp_v, self.bright_v), (t, b), move_sliders=True, done=self.save_now)
        self.temp_v, self.bright_v = t, b

    def fade(self, start, end, move_sliders, done):
        """Ease the screen (and maybe the sliders) from start to end."""
        self.stop_anim()
        if self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_timer = None
        t0 = GLib.get_monotonic_time()

        def step():
            p = min((GLib.get_monotonic_time() - t0) / 1000 / FADE_MS, 1)
            e = 1 - (1 - p) ** 3  # ease out
            t = round(start[0] + (end[0] - start[0]) * e)
            b = round(start[1] + (end[1] - start[1]) * e)
            self.live.push(t, b)
            if move_sliders:
                self.quiet = True
                self.temp.set_value(t)
                self.bright.set_value(b)
                self.quiet = False
            if p >= 1:
                self.anim = None
                done()
                return False
            return True

        self.anim = GLib.timeout_add(16, step)

    def stop_anim(self):
        if self.anim:
            GLib.source_remove(self.anim)
            self.anim = None

    def schedule_save(self):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(SAVE_AFTER_MS, self.save_now)

    def save_now(self):
        self.save_timer = None
        if self.is_on:
            subprocess.Popen([TOOL, "set", str(self.temp_v), str(self.bright_v)])
        return False

    def on_key(self, _c, key, *_):
        if key == Gdk.KEY_Escape:
            self.close()
            return True
        if key in (Gdk.KEY_p, Gdk.KEY_P):
            self.save_shot()
            return True
        return False

    # ---- closing on focus loss, but not under a screenshot --------------

    def on_focus(self, *_):
        if not self.is_active():
            GLib.timeout_add(150, self.close_unless_shooting)

    def close_unless_shooting(self):
        """slurp takes the keyboard to pick a region; stay until it and grim are done."""
        if self.is_active():
            return False
        if subprocess.run(["pgrep", "-x", "slurp|grim"], capture_output=True).returncode == 0:
            return True  # look again shortly
        self.close()
        return False

    def save_shot(self):
        """Render the menu itself, not the screen: crisp at 2x, see-through around the walls."""
        child = self.get_child()
        w, h = child.get_width(), child.get_height()
        snap = Gtk.Snapshot()
        snap.scale(SHOT_SCALE, SHOT_SCALE)
        Gtk.WidgetPaintable.new(child).snapshot(snap, w, h)
        node = snap.to_node()
        texture = self.get_renderer().render_texture(node, Graphene.Rect().init(0, 0, w * SHOT_SCALE, h * SHOT_SCALE))
        os.makedirs(SHOT_DIR, exist_ok=True)
        path = f"{SHOT_DIR}/castle-menu_{datetime.datetime.now():%Y-%m-%d_%H-%M-%S}.png"
        texture.save_to_png(path)
        try:
            with open(path, "rb") as f:
                # wl-copy stays running to serve the clipboard, so cut it loose
                subprocess.Popen(["wl-copy", "--type", "image/png"], stdin=f, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass
        self.clock.set_label("SAVED")
        self.clock.add_css_class("hint")
        GLib.timeout_add(1500, lambda: (self.clock.remove_css_class("hint"), self.tick(), False)[2])

    def on_close(self, _w):
        if self.anim:  # finish what was asked for before going away
            self.stop_anim()
            if self.is_on:
                self.save_now()
            else:
                subprocess.Popen([TOOL, "off"])
        elif self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_now()
        return False


def main():
    app = Gtk.Application(application_id="land.deathcastle.menu")

    def activate(app):
        # GTK 4.16+ turns hinting off by default, which makes small text blurry
        st = Gtk.Settings.get_default()
        st.props.gtk_font_rendering = Gtk.FontRendering.MANUAL
        st.props.gtk_xft_antialias = 1
        st.props.gtk_xft_hinting = 1
        st.props.gtk_xft_hintstyle = "hintslight"
        st.props.gtk_hint_font_metrics = True
        css = Gtk.CssProvider()
        try:
            palette = open(COLORS).read().split("* {")[0]  # just the @define-color lines
        except OSError:
            palette = ""
        # warmth trough shows the real colours, day on the left, ember on the right
        stops = ", ".join(css_rgb(kelvin(k)) for k in range(T_MAX, T_MIN - 1, -500))
        warm = f".warm trough {{ background-image: linear-gradient(to right, {stops}); }}"
        css.load_from_string(palette + CSS + warm)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER)
        Menu(app).present()

    app.connect("activate", activate)
    app.run(None)


if __name__ == "__main__":
    main()
